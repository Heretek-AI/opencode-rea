{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@heretek-ai/opencode-rea",
  "version": "0.1.1",
  "description": "opencode-rea plugin",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heretek-AI/opencode-rea.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "index.js"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "test": "bun test --path-ignore-patterns 'review/**' test/unit",
    "test:unit": "bun test --path-ignore-patterns 'review/**' test/unit",
    "test:integration": "bun test --path-ignore-patterns 'review/**' test/integration",
    "test:e2e": "bun run build && bun test --path-ignore-patterns 'review/**' test/e2e"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2"
  },
  "devDependencies": {
    "@opencode/cli": "2.0.26",
    "@opencode/plugin": "2.0.26",
    "@opencode/sdk": "2.0.26",
    "@types/bun": "1.3.4",
    "rea-agents": "6.4.0",
    "typescript": "5.9.2"
  },
  "trustedDependencies": [
    "@opencode/cli"
  ]
}
