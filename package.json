{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-rea",
  "version": "0.1.0",
  "description": "OpenCode v2 plugin for REA (reverse-engineer-anything) MCP integration",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "index.js"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test --path-ignore-patterns 'review/**' test/unit",
    "test:unit": "bun test --path-ignore-patterns 'review/**' test/unit",
    "test:integration": "bun test --path-ignore-patterns 'review/**' test/integration",
    "test:e2e": "bun run build && bun test --path-ignore-patterns 'review/**' test/e2e"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2"
  },
  "devDependencies": {
    "@opencode/cli": "2.0.26",
    "@opencode/plugin": "2.0.26",
    "@opencode/sdk": "2.0.26",
    "@types/bun": "1.3.4",
    "rea-agents": "6.5.0",
    "typescript": "5.9.2"
  },
  "trustedDependencies": [
    "@opencode/cli"
  ]
}
